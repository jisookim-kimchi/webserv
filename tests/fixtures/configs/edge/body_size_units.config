# Body size unit edge cases (parser keeps digit prefix then applies unit)

server
{
    listen 11000;
    host 127.0.0.1;
    server_name size-k;
    client_max_body_size 2K;

    location /
    {
        root /tmp;
        allow_methods GET;
        autoindex off;
    }
}

server
{
    listen 11001;
    host 127.0.0.1;
    server_name size-m;
    client_max_body_size 3M;

    location /
    {
        root /tmp;
        allow_methods GET;
        autoindex off;
    }
}

server
{
    listen 11002;
    host 127.0.0.1;
    server_name size-g;
    client_max_body_size 1G;

    location /
    {
        root /tmp;
        allow_methods GET;
        autoindex off;
    }
}

server
{
    listen 11003;
    host 127.0.0.1;
    server_name size-raw;
    client_max_body_size 4096;

    location /
    {
        root /tmp;
        allow_methods GET;
        autoindex off;
    }
}
