# Edge: comments, tabs, blank lines, mixed spacing, trailing comments

server	{	# open server
	listen		9001	;	# first listen
		listen 9002;

	host			127.0.0.1;

	# many names on one line
	server_name	edge.local	alias.edge	www.edge.local;

	client_max_body_size	512K;

	error_page	400 401 403	/errors/4xx.html;
	error_page	404	/errors/404.html;

	location	/	{
		root	/var/www/edge;
		index	index.html	default.html;
		allow_methods	GET	HEAD;
		autoindex	on;
	}

	# extension CGI with silly spacing
	location	.py{
		cgi_pass	/usr/bin/python3;
		allow_methods	GET POST;
	}

	location	/api/v1/deep/path	{
		root	/var/www/edge/api;
		allow_methods	GET POST DELETE;
		autoindex	off;
		return	307	https://example.com/moved;
	}
}

# second vhost squeezed onto fewer lines
server{listen 9003;host 0.0.0.0;server_name packed;client_max_body_size 1G;location /{root /tmp;allow_methods GET;autoindex off;}}
