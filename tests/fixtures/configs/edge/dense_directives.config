# Many listens, many names, many error pages, nested-looking paths

server
{
    listen 10000;
    listen 10001;
    listen 10002;
    listen 10003;
    listen 10004;
    listen 10005;
    listen 10006;
    listen 10007;
    listen 10008;
    listen 10009;

    host 127.0.0.1;
    server_name a b c d e f g h i j k l m n o p q r s t u v w x y z;
    client_max_body_size 64K;

    error_page 400 /e/400.html;
    error_page 401 /e/401.html;
    error_page 402 /e/402.html;
    error_page 403 /e/403.html;
    error_page 404 /e/404.html;
    error_page 405 /e/405.html;
    error_page 408 /e/408.html;
    error_page 413 /e/413.html;
    error_page 500 501 502 503 504 /e/5xx.html;

    location /
    {
        root /data/root;
        index a.html b.html c.html d.html e.html;
        allow_methods GET POST PUT DELETE HEAD OPTIONS;
        autoindex on;
    }

    location /a
    {
        root /data/a;
        allow_methods GET;
        autoindex off;
    }

    location /a/b
    {
        root /data/a/b;
        allow_methods GET POST;
        autoindex off;
    }

    location /a/b/c
    {
        root /data/a/b/c;
        allow_methods GET;
        autoindex on;
    }

    location /a/b/c/d
    {
        root /data/a/b/c/d;
        allow_methods GET DELETE;
        autoindex off;
    }

    location /upload
    {
        root /data/upload;
        allow_methods POST DELETE;
        autoindex off;
    }

    location /redirect
    {
        return 301 https://example.org/;
    }

    location .cgi
    {
        cgi_pass /usr/local/bin/cgi-bin;
        allow_methods GET POST;
    }

    location .py
    {
        cgi_path /usr/bin/python3;
        allow_methods GET POST;
    }

    location /.hidden
    {
        root /data/hidden;
        allow_methods GET;
        autoindex off;
    }

    location /unicode-ish
    {
        root /data/unicode;
        index index.html;
        allow_methods GET;
        autoindex off;
    }
}
