
server
{
    listen              8080;
    host                0.0.0.0;
    server_name         localhost;
    client_max_body_size 10M;

    error_page 404 /errors/404.html;
    error_page 500 502 503 600 /errors/50x.html; #exceed max status code

    location /
    {
        root            www;
        index           index.html index.htm;
        allow_methods   GET POST;
        autoindex       on;
    }
}
