# Nginx-style default configuration for webserv

server {
    listen              8080;
    host                127.0.0.1;
    server_name         localhost;
    client_max_body_size 10M;

    # Custom Error Pages
    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    # Root route: serves the Welcome page
    location / {
        root            www;
        index           index.html index.htm;
        allow_methods   GET POST;
        autoindex       off;
    }

    # Redirection route to official Nginx documentation (nginx.org)
    location /redirect {
        return 301      http://nginx.org;
    }

    # Direct documentation redirect
    location /documentation {
        return 301      http://nginx.org;
    }

    # Upload & Delete Route
    location /upload {
        root            www/upload;
        allow_methods   GET POST DELETE;
        autoindex       on;
    }

    # CGI Execution Routes
    location .py {
        allow_methods   GET POST;
        cgi_pass        /usr/bin/python3;
    }

    location .php {
        allow_methods   GET POST;
        cgi_pass        /usr/bin/php-cgi;
    }
}

# Virtual Host 2 (Test Server on port 8081)
server {
    listen              8081;
    host                127.0.0.1;
    server_name         test.local;
    client_max_body_size 1M;

    error_page 404 /errors/404.html;

    location / {
        root            www_test;
        index           index.html;
        allow_methods   GET;
        autoindex       off;
    }
}
