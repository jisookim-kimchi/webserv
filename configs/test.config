
# Server 1: Primary Server (Port 8080)
server
{
    listen              8080;
    host                0.0.0.0;
    server_name         localhost;
    client_max_body_size 10M;

    # Custom Error Pages
    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    # 1. Root route: Static files with default index
    location /
    {
        root            www;
        index           index.html index.htm;
        allow_methods   GET POST;
        autoindex       on;
    }

    # 2. Upload and Delete Route (Full REST: GET, POST, DELETE with autoindex)
    location /upload
    {
        root            www/upload;
        allow_methods   GET POST DELETE;
        autoindex       on;
    }

    # 3. Method Test: GET only (POST/DELETE will return 405 Method Not Allowed)
    location /get_only
    {
        root            www;
        index           index.html;
        allow_methods   GET;
        autoindex       off;
    }

    # 4. Method Test: POST only (GET/DELETE will return 405 Method Not Allowed)
    location /post_only
    {
        root            www/upload;
        allow_methods   POST;
        autoindex       off;
    }

    # 5. Method Test: DELETE only (GET/POST will return 405 Method Not Allowed)
    location /delete_only
    {
        root            www/upload;
        allow_methods   DELETE;
        autoindex       off;
    }

    # 6. Body Size Limit Test (Limits body to 10 bytes -> 413 Payload Too Large)
    location /limit
    {
        root            www/upload;
        allow_methods   GET POST;
        client_max_body_size 10;
        autoindex       off;
    }

    # 7. Redirection: 301 Moved Permanently
    location /redirect
    {
        return 301      http://nginx.org;
    }

    # 8. Redirection: 302 Found (Internal redirect)
    location /redirect_temp
    {
        return 302      /upload/;
    }

    # 9. Autoindex Disabled Test (Returns 404 when no index file exists)
    location /no_autoindex
    {
        root            www/no_autoindex;
        allow_methods   GET;
        autoindex       off;
    }

    # 10. Python CGI Execution Route (.py)
    location .py
    {
        allow_methods   GET POST;
        cgi_pass        /usr/bin/python3;
    }

    # 11. PHP CGI Execution Route (.php)
    location .php
    {
        allow_methods   GET POST;
        cgi_pass        /usr/bin/php-cgi;
    }
}

# Server 2: Secondary Server / Virtual Host (Port 8081)
server
{
    listen              8081;
    host                0.0.0.0;
    server_name         test.local;
    client_max_body_size 1M;

    error_page 404 /errors/404.html;

    location /
    {
        root            www_test;
        index           index.html;
        allow_methods   GET;
        autoindex       off;
    }
}
