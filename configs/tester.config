# 42 Webserv Official Tester Configuration

server
{
    listen              8080;
    host                127.0.0.1;
    server_name         localhost;
    client_max_body_size 100M;

    # Custom Error Pages
    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    # 1. Root Route (GET only)
    location /
    {
        root            YoupiBanane;
        index           youpi.bad_extension;
        allow_methods   GET;
    }

    # 2. PUT Test Route (file upload test)
    location /put_test
    {
        root            www/upload;
        allow_methods   PUT;
    }

    # 3. Post Body Size Limit Test (100 bytes)
    location /post_body
    {
        root            YoupiBanane;
        index           youpi.bad_extension;
        allow_methods   POST;
        client_max_body_size 100;
    }

    # 4. YoupiBanane Directory Route
    location /directory
    {
        root            YoupiBanane;
        index           youpi.bad_extension;
        allow_methods   GET POST;
    }

    # 5. Official CGI Tester Mapping (.bla) (POST only)
    location .bla
    {
        allow_methods   POST;
        cgi_pass        /home/jisookim/42webserv/cgi_tester;
    }

    # 6. Optional: Python CGI
    location .py
    {
        allow_methods   GET POST;
        cgi_pass        /usr/bin/python3;
    }
}
