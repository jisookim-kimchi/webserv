# Evaluation test: multiple server blocks on the exact same host:port.
# Per 42 evaluation sheet: "This should result in an error, unless the team has chosen to implement the virtual host feature."
# This server rejects duplicate listen address at startup.

server
{
    listen              8080;
    host                127.0.0.1;
    server_name         site1.local;

    location /
    {
        root            www;
        allow_methods   GET;
    }
}

server
{
    listen              8080;
    host                127.0.0.1;
    server_name         site2.local;

    location /
    {
        root            www_test;
        allow_methods   GET;
    }
}
